local function addSlider(parent, label, yPos, minVal, maxVal, step, action)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0.9, -20, 0, 40)
    frame.Position = UDim2.new(0, 10, 0, yPos)
    frame.BackgroundTransparency = 1
    frame.Parent = parent

    local labelObj = Instance.new("TextLabel")
    labelObj.Size = UDim2.new(0.2, 0, 0.5, 0)
    labelObj.Position = UDim2.new(0, 0, 0, 0)
    labelObj.BackgroundTransparency = 1
    labelObj.Text = label
    labelObj.TextColor3 = WHITE
    labelObj.Font = Enum.Font.SourceSansBold
    labelObj.TextSize = 14
    labelObj.TextXAlignment = Enum.TextXAlignment.Left
    labelObj.Parent = frame

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.12, 0, 0.5, 0)
    valueLabel.Position = UDim2.new(0.88, 0, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(minVal)
    valueLabel.TextColor3 = GREEN_BRIGHT
    valueLabel.Font = Enum.Font.SourceSansBold
    valueLabel.TextSize = 14
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = frame

    local sliderBg = Instance.new("Frame")
    sliderBg.Size = UDim2.new(0.6, 0, 0.4, 0)
    sliderBg.Position = UDim2.new(0.22, 0, 0.5, 0)
    sliderBg.BackgroundColor3 = BG3
    sliderBg.BorderColor3 = GREEN
    sliderBg.BorderSizePixel = 1
    sliderBg.Parent = frame
    local bgCorner = Instance.new("UICorner")
    bgCorner.CornerRadius = UDim.new(0, 3)
    bgCorner.Parent = sliderBg

    local sliderFill = Instance.new("Frame")
    sliderFill.Size = UDim2.new(0, 0, 1, 0)
    sliderFill.BackgroundColor3 = GREEN
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = sliderBg
    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(0, 3)
    fillCorner.Parent = sliderFill

    local sliderBtn = Instance.new("TextButton")
    sliderBtn.Size = UDim2.new(0, 16, 1.5, 0)
    sliderBtn.Position = UDim2.new(0, -8, -0.25, 0)
    sliderBtn.BackgroundColor3 = GREEN_BRIGHT
    sliderBtn.BorderColor3 = WHITE
    sliderBtn.BorderSizePixel = 1
    sliderBtn.Text = ""
    sliderBtn.Parent = sliderBg
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 3)
    btnCorner.Parent = sliderBtn

    local currentValue = minVal
    local dragging = false

    local function updateSlider(inputPos)
        local bgPos = sliderBg.AbsolutePosition.X
        local bgSize = sliderBg.AbsoluteSize.X
        local pos = math.clamp((inputPos - bgPos) / bgSize, 0, 1)
        local value = minVal + (maxVal - minVal) * pos
        value = math.round(value / step) * step
        value = math.clamp(value, minVal, maxVal)
        currentValue = value
        sliderFill.Size = UDim2.new(pos, 0, 1, 0)
        sliderBtn.Position = UDim2.new(pos, -8, -0.25, 0)
        valueLabel.Text = string.format("%.2f", value)
        execEvent:FireServer({action = action, args = {tostring(value)}})
    end

    sliderBtn.MouseButton1Down:Connect(function() dragging = true end)
    sliderBtn.MouseButton1Up:Connect(function() dragging = false end)
    sliderBtn.MouseLeave:Connect(function() dragging = false end)

    game:GetService("UserInputService").InputChanged:Connect(function(input, gameProcessed)
        if dragging and not gameProcessed and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input.Position.X)
        end
    end)

    return frame
end

