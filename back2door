local function addButton(parent, text, yPos, action, args, color, widthScale)
    widthScale = widthScale or 0.9
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(widthScale, -20, 0, 28)
    btn.Position = UDim2.new((1 - widthScale)/2, 10, 0, yPos)
    btn.BackgroundColor3 = color or BG3
    btn.BorderColor3 = GREEN
    btn.BorderSizePixel = 1
    btn.Text = text
    btn.TextColor3 = WHITE
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.Parent = parent
    btn.MouseButton1Click:Connect(function()
        execEvent:FireServer({action = action, args = args or {}})
    end)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = btn
    return btn
end

